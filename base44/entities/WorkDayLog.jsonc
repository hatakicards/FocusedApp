{
  "name": "WorkDayLog",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "title": "Data"
    },
    "work_hours": {
      "type": "number",
      "minimum": 0,
      "maximum": 24,
      "title": "Ore di lavoro"
    },
    "study_hours": {
      "type": "number",
      "minimum": 0,
      "maximum": 24,
      "title": "Ore di studio"
    },
    "meetings_count": {
      "type": "integer",
      "minimum": 0,
      "title": "Numero riunioni"
    },
    "work_rating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "title": "Voto giornata lavorativa"
    },
    "earnings": {
      "type": "number",
      "minimum": 0,
      "title": "Guadagno giornaliero"
    },
    "notes": {
      "type": "string",
      "title": "Note"
    }
  },
  "required": [
    "date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}