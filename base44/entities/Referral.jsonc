{
  "name": "Referral",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "title": "Descrizione",
      "maxLength": 1000
    },
    "referrer_id": {
      "type": "string",
      "title": "ID referrer"
    },
    "invitee_id": {
      "type": "string",
      "title": "ID invitato"
    },
    "invitee_email": {
      "type": "string",
      "title": "Email invitato"
    },
    "credits_earned": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "title": "Crediti guadagnati"
    },
    "spent_euros": {
      "type": "number",
      "minimum": 0,
      "default": 0,
      "title": "Euro spesi dall'invitato"
    }
  },
  "required": [
    "referrer_id",
    "invitee_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.referrer_id": "{{user.id}}"
        },
        {
          "data.invitee_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}