{
  "name": "DailyRating",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "title": "Descrizione",
      "maxLength": 1000
    },
    "activity_id": {
      "type": "string",
      "title": "ID Attivit\u00e0"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Data"
    },
    "rating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "title": "Voto"
    }
  },
  "required": [
    "activity_id",
    "date",
    "rating"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}