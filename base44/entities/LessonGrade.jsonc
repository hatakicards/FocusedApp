{
  "name": "LessonGrade",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "title": "Data"
    },
    "subject": {
      "type": "string",
      "title": "Materia"
    },
    "grade": {
      "type": "number",
      "title": "Voto"
    },
    "grade_system": {
      "type": "string",
      "enum": [
        "letter",
        "scale6",
        "scale10",
        "scale30"
      ],
      "default": "scale10",
      "title": "Sistema di valutazione"
    },
    "notes": {
      "type": "string",
      "title": "Note"
    }
  },
  "required": [
    "date",
    "subject",
    "grade",
    "grade_system"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}