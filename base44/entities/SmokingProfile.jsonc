{
  "name": "SmokingProfile",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "title": "Descrizione",
      "maxLength": 1000
    },
    "encrypted_data": {
      "type": "string",
      "title": "Dati crittografati (E2E)"
    },
    "onboarded": {
      "type": "boolean",
      "default": false,
      "title": "Onboarding completato"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}