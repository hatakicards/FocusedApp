# ============================================================================
# Copia questo file in ".env.local" per lo sviluppo locale (npm run dev) e
# compilalo con i tuoi valori reali. Per la produzione, le stesse variabili
# vanno impostate nella dashboard Netlify (Site configuration -> Environment
# variables) — .env.local NON viene mai deployato, resta solo sul tuo computer.
#
# Vedi GUIDA_MIGRAZIONE.md per dove trovare ogni singolo valore.
# ============================================================================


# ---- Frontend (Vite) --------------------------------------------------------
# Vanno DAVANTI a "VITE_" per essere accessibili dal browser: Supabase Project
# Settings -> API. La anon key e' pubblica per design (protetta dalla RLS).

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# app.revenuecat.com -> il tuo progetto -> API Keys. Sono chiavi "publishable",
# una per piattaforma, usate solo dentro l'app nativa (Capacitor.isNativePlatform()).
VITE_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxxxxx


# ---- Netlify Functions (solo server, MAI esposte al browser) ---------------
# Stessi valori Supabase di sopra, ma senza prefisso VITE_ (le Netlify
# Functions girano in un processo Node separato dal bundle frontend).

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase Project Settings -> API -> service_role key. Bypassa ogni regola
# RLS: NON deve MAI finire nel frontend o in un repository pubblico.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Stripe Dashboard -> Developers -> API keys (usa la chiave "secret", sk_live_... o sk_test_...)
STRIPE_SECRET_KEY=your-stripe-secret-key-here

# Stripe Dashboard -> Developers -> Webhooks -> (il tuo endpoint) -> Signing secret
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# console.groq.com/keys -> Create API Key (piano gratuito, nessuna carta richiesta)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Opzionale: modello da usare per Focusy e il routine optimizer.
# Se lo lasci vuoto viene usato "openai/gpt-oss-120b".
GROQ_MODEL=

# resend.com -> API Keys (piano gratuito sufficiente per il form contatti)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Opzionali: destinatario/mittente del form contatti.
# Se li lasci vuoti: CONTACT_EMAIL_TO=focusedappp@gmail.com,
# CONTACT_EMAIL_FROM="Focused <onboarding@resend.dev>"
CONTACT_EMAIL_TO=
CONTACT_EMAIL_FROM=

# Opzionale ma consigliato: RevenueCat -> progetto -> Integrations -> Webhooks
# -> "Authorization header value" (una stringa a piacere, la stessa qui e li).
# Senza questo, chiunque conosca l'URL puo' chiamare il webhook.
REVENUECAT_WEBHOOK_SECRET=
